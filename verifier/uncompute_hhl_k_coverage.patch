+# k* = B + d, where d in [-128, 127] comes from the shot's own XOF.
+RANDOM_TESTS = 9024
+N_DOMAIN = X_MAX - X_MIN + 1
+CARRY_BOUNDARIES = (0, 1 << 31, 1 << 32)
